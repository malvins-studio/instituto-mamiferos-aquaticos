# Supabase (Settings > Database > Connect no painel do projeto).
#
# DATABASE_URL: connection string do "Transaction pooler" (porta 6543, via Supavisor).
# Usada em runtime pelo Prisma Client (src/lib/prisma.ts) — suporta muitas conexões
# simultâneas, essencial em ambiente serverless (Vercel).
#
# sslmode=no-verify (não "require"): criptografa a conexão sem validar a cadeia
# de certificado — testado e confirmado necessário, já que a cadeia do pooler do
# Supabase não é reconhecida pelas CAs padrão do Node ("sslmode=require" hoje é
# tratado como alias de "verify-full" pelo driver e falha com
# "self-signed certificate in certificate chain").
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&sslmode=no-verify"

# DIRECT_URL: connection string "Direct connection" ou "Session pooler" (porta 5432).
# Usada só pela Prisma CLI (prisma.config.ts) para migrations — o pooler em modo
# transaction (6543) não suporta os comandos que `prisma migrate` precisa rodar.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=no-verify"

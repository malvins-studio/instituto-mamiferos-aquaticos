# Banco de dados (Supabase PostgreSQL)
# DATABASE_URL: Connection string do Transaction pooler (porta 6543, via Supavisor)
# Usada em runtime pelo Prisma Client para queries — suporta muitas conexões simultâneas
# Essencial em ambiente serverless (Vercel)
DATABASE_URL="postgresql://user:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?schema=public&sslmode=no-verify"

# DIRECT_URL: Connection string para migrations (porta 5432)
# Usada só pela Prisma CLI (prisma.config.ts) para executar prisma migrate
# O pooler em modo transaction (6543) não suporta commands do prisma migrate
DIRECT_URL="postgresql://user:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?schema=public"

# Node environment
NODE_ENV="development"
